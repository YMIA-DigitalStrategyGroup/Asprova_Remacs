    {
      "$type": "ServerDesignerCommon.Command.ExecuteSqlCommand, ServerDesignerCommon",
      "ConnStrId": "MySql本番環境",
      "Params": {},
      "SqlStatement": "DELETE FROM ymia_t_asprova_2remacs",
      "ID": "f32aa1457c7545c5b6fd6b6e626bc2af",
      "Comments": "Remacsに送信すべき情報の内容を一度全部削除する"
    },
    {
      "$type": "ServerDesignerCommon.Command.ExecuteSqlCommand, ServerDesignerCommon",
      "ConnStrId": "MySql本番環境",
      "Params": {},
      "SqlStatement": "INSERT INTO ymia_t_asprova_jisseki_new (機種, 機番, 工程コード, 開始日, 終了日)\r\nSELECT \r\n    機種, \r\n    機番, \r\n    'X9900' AS 工程コード, \r\n    開始日, \r\n    終了日\r\nFROM \r\n    ymia_t_asprova_jisseki_new\r\nWHERE \r\n    工程コード = 'D0300'",
      "ID": "3239061b4cfc4f8da3ca0b88e0a277bb"
    },
    {
      "$type": "ServerDesignerCommon.Command.ExecuteSqlCommand, ServerDesignerCommon",
      "ConnStrId": "MySql本番環境",
      "Params": {},
      "SqlStatement": "INSERT INTO ymia_t_asprova_jisseki_remacs (\r\n    日付,\r\n    機種,\r\n    機番,\r\n    伝票No,\r\n    工程コード,\r\n    開始,\r\n    終了,\r\n    送信フラグ,\r\n    数量\r\n)\r\nSELECT \r\n    new_t.終了日 AS 日付,\r\n    new_t.機種,\r\n    new_t.機番,\r\n    source.DENPYO_NBR AS 伝票No,\r\n    new_t.工程コード,\r\n    1 AS 開始,\r\n    1 AS 終了,\r\n    0 AS 送信フラグ,\r\n    source.SURYO AS 数量\r\nFROM \r\n    ymia_t_asprova_jisseki_new AS new_t\r\nINNER JOIN \r\n    thatchum AS source\r\n    ON REPLACE(source.SEIBAN, ' ', '') = CONCAT(new_t.機種, new_t.機番)\r\n   AND source.KOTEI_CODE = new_t.工程コード\r\nWHERE \r\n    new_t.開始日 IS NOT NULL \r\n    AND new_t.終了日 IS NOT NULL\r\n    AND new_t.開始日 <= new_t.終了日\r\n    AND NOT EXISTS (\r\n        SELECT 1 \r\n        FROM ymia_t_asprova_jisseki_remacs AS remacs_t\r\n        WHERE remacs_t.機種 = new_t.機種\r\n          AND remacs_t.機番 = new_t.機番\r\n          AND remacs_t.工程コード = new_t.工程コード\r\n          AND remacs_t.伝票No = source.DENPYO_NBR -- ★伝票番号での絞り込み\r\n          AND remacs_t.送信フラグ = 1\r\n    )",
      "ID": "b6cda79fb3204133adcf2a49405e4562",
      "Comments": "ymia_t_asprova_jisseki に存在していて、\nymia_t_asprova_jisseki_remacs にはまだ存在しない実績データだけを追加する（この際　まだ送信フラグは０になっている）\r\n＝重複登録防止付きの差分INSART"
    },
    {
      "$type": "ServerDesignerCommon.Command.ExecuteSqlCommand, ServerDesignerCommon",
      "ConnStrId": "MySql本番環境",
      "Params": {},
      "SqlStatement": "insert into ymia_t_asprova_2remacs\r\nselect 日付, '9998', 伝票No, '', 終了, 0, 0, 開始, 終了, 0\r\nfrom ymia_t_asprova_jisseki_remacs where 送信フラグ = 0\r\n",
      "ID": "7e0ce77c994a4538a2bbc62c84f41dd7",
      "Comments": "ymia_t_asprova_jisseki_remacs のうち、\nまだ送信していない（送信フラグ = 0）実績だけを、\nymia_t_asprova_2remacs に登録する（ただし未送信のもののみ設定）\r\n＝Remacs送信用データ作成"
    },
    {
      "$type": "ServerDesignerCommon.Command.ExecuteSqlCommand, ServerDesignerCommon",
      "ConnStrId": "MySql本番環境",
      "Params": {},
      "SqlStatement": "insert into ymia_t_asprova_2remacs\r\nselect 日付, 社員コード, 伝票番号, '', 0, 0, 作業時間, 0, 0, 0 from ymia_t_seisan_jissekidt\r\nwhere 連携フラグ = 0\r\n",
      "ID": "6f238e2329ef4199a7281eb59886a9ca",
      "Comments": "ymia_t_seisan_jissekidt のうち、\nまだ Remacs と連携していない（連携フラグ = 0）作業実績だけを、\nymia_t_asprova_2remacs に追加する\r\n＝人作業実績のRemacs送信用データ作成"
    },
